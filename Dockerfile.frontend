FROM node:18-alpine as build

WORKDIR /app
COPY upsc-ai-test-frontend-flat/package*.json ./
RUN npm install
COPY upsc-ai-test-frontend-flat ./
RUN npm run build

FROM node:18-alpine

WORKDIR /app
RUN npm install -g serve
COPY --from=build /app/dist ./dist

EXPOSE 3000

CMD ["serve", "-s", "dist", "-l", "3000"]
