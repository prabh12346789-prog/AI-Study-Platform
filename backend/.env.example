APP_NAME=UPSC AI Mentor
APP_VERSION=1.0.0
DEBUG=True
HOST=127.0.0.1
PORT=8000

DATABASE_URL=sqlite:///./data/memory.sqlite3

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GENERATION_MODEL=qwen2.5:3b
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_GENERATION_TIMEOUT_SECONDS=180

EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_TIMEOUT_SECONDS=60
OLLAMA_HEALTH_TIMEOUT_SECONDS=1
VECTOR_DB=chromadb
CHROMA_COLLECTION=documents_ollama_nomic_embed_text
CHROMA_DB_PATH=./chroma_db
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.70

ENABLE_WEB_SEARCH=True
SEARCH_PROVIDER=bing_rss
MAX_WEB_RESULTS=5
WEB_CACHE_ENABLED=True
WEB_CACHE_DIR=./data/web_cache
WEB_STABLE_CACHE_DAYS=30
WEB_CURRENT_CACHE_HOURS=24
CHAT_MIN_GROUNDING_CONFIDENCE=0.70
ROADMAP_MIN_GROUNDING_CONFIDENCE=0.78
MAX_CHAT_HISTORY=10

INTERNAL_ADMIN_KEY=replace-with-a-new-local-admin-key
CA_DAILY_MAX_RESULTS=10
CA_DAILY_LANGUAGE=english
CA_DAILY_TIME=07:00
